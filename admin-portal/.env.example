# TenderTrack admin portal — configuration
#
# 1. Copy this file and name the copy .env (in this same folder).
# 2. Fill in the three values from Supabase -> Project Settings -> API Keys.
# 3. Never commit .env to GitHub: it holds the secret key. .gitignore already
#    excludes it.

# Your project URL. Nothing after .supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLIC key the Android app uses (anon, or publishable sb_publishable_...).
# This one is sent to the browser, which is fine: it is public by design.
SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key-here

# The SECRET key (sb_secret_... or the legacy service_role key).
# It stays on this computer and is used only by server.js.
SUPABASE_SECRET_KEY=paste-the-secret-key-here

# Optional
ADMIN_PORT=5050
# Signs the administrator out after this many minutes without activity (5-60).
IDLE_MINUTES=15
