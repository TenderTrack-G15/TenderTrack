<?xml version="1.0" encoding="utf-8"?>
<!--
  The briefcase, centred in the icon. An adaptive icon is 108 x 108 and the
  launcher crops it to a circle or rounded square of about 72 x 72 in the
  middle, so the drawing is kept inside the central 66 x 66 "safe zone".
  The briefcase is a 24-unit drawing centred on (12, 12): it is scaled by 2
  around that point and moved by 42, which puts its centre at (54, 54), the
  exact middle of the icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="42"
        android:translateY="42">
        <path
            android:pathData="M3,7 h18 a2,2 0 0 1 2,2 v9 a2,2 0 0 1 -2,2 h-18 a2,2 0 0 1 -2,-2 v-9 a2,2 0 0 1 2,-2 z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8" />
        <path
            android:pathData="M8.5,7 V5.5 a1.5,1.5 0 0 1 1.5,-1.5 h4 a1.5,1.5 0 0 1 1.5,1.5 V7"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8" />
        <path
            android:pathData="M1,12 H23"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8" />
    </group>
</vector>
