# eTender Demo Portal — configuration
#
# 1. Copy this file and name the copy .env (in this same folder).
# 2. Fill in the three Supabase values from Supabase -> Project Settings -> API Keys.
#    Use the SAME Supabase project as the TenderTrack app and the admin portal.
# 3. Never commit .env to GitHub: it holds the secret key (and your email
#    password if you switch on real email). .gitignore already excludes it.

# Your project URL. Nothing after .supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLIC key the Android app uses (anon, or publishable sb_publishable_...).
# It is sent to the browser, which is fine: it is public by design.
SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key-here

# The SECRET key (sb_secret_... or the legacy service_role key).
# It stays on this computer. server.js uses it to create supplier logins and
# to read the email outbox (award codes). It never reaches the browser.
SUPABASE_SECRET_KEY=paste-the-secret-key-here

# Optional
PORTAL_PORT=5070
# How often (seconds) the server checks the database for emails to send.
OUTBOX_SECONDS=10

# ---------------------------------------------------------------------------
# Real email (optional)
#
# Leave these commented out and award codes and bid receipts appear in the
# portal's Demo mailbox (on this computer only) instead of a real inbox.
#
# To send real emails through Gmail:
#   a) Use a Gmail account made for the project (not a personal one).
#   b) Google Account -> Security -> turn on 2-Step Verification.
#   c) Google Account -> Security -> App passwords -> create one called
#      "eTender demo". Google shows 16 letters: paste them below.
#   d) Remove the # in front of the four lines and restart the portal.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.project.account@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM_NAME=eTender Demo Portal
#
# Real email goes only to addresses at the same domain as SMTP_USER (for
# Gmail: other @gmail.com addresses). The sample companies have made-up
# addresses that could belong to real businesses, so their emails stay in the
# demo mailbox. To allow more, list addresses or @domains, comma-separated:
# EMAIL_ALLOWLIST=@ukzn.ac.za, sine.team@outlook.com
